 char savename[SAVESIZE]; /* holds relative path of save file from playground */
 
+const char *dir = (char*) 0;
+
 int
 main(argc, argv)
 int argc;
 char *argv[];
 {
     int argno;
-    const char *dir = (char *) 0;
 #ifdef AMIGA
     char *startdir = (char *) 0;
