     if (read(gfd, (genericptr_t) &hpid, sizeof hpid) != sizeof hpid) {
@@ -315,7 +319,8 @@ char *basename;
         || (read(gfd, (genericptr_t) &pltmpsiz, sizeof pltmpsiz)
